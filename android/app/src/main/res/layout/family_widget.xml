<?xml version="1.0" encoding="utf-8"?>
<!-- 112 Widgets: RemoteViews layout. Buttons are at least 44dp tall. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_medicine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_no_medicine"
        android:textColor="#FF1F1D1A"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_scan"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="@string/widget_scan"
            android:contentDescription="@string/widget_scan"
            android:textColor="#FF1F1D1A" />

        <TextView
            android:id="@+id/widget_paste"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="@string/widget_paste"
            android:contentDescription="@string/widget_paste"
            android:textColor="#FF1F1D1A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_dial_0"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FF1F1D1A"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_dial_1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FF1F1D1A"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_dial_2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FF1F1D1A"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
